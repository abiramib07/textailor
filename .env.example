# Copy to .env and fill in for the auth module (src/auth). Never commit .env.

# JWT signing secret — set a fixed random value in any persistent environment.
# If unset, a random secret is generated at process start (sessions won't
# survive a server restart).
AUTH_JWT_SECRET=

# "true" (default) logs/echoes OTPs instead of sending real SMS — no SMS
# gateway is configured yet. Set to "false" once AUTH_SMS_PROVIDER is real.
AUTH_DEV_MODE=true

# "development" (default) or "production" — controls the cookie Secure flag.
# Only set to "production" when serving over HTTPS.
AUTH_APP_ENV=development

AUTH_FRONTEND_ORIGIN=http://localhost:4200
AUTH_BACKEND_ORIGIN=http://localhost:8000

# SMS provider: "console" (default, dev-only) or "twilio"
AUTH_SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google OAuth 2.1 — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Email Generator "Send Email" button — sends over Gmail SMTP with an
# app password (not your regular Gmail password). Enable 2FA on the
# sending account, then generate one at
# https://myaccount.google.com/apppasswords
GMAIL_SENDER_ADDRESS=
GMAIL_APP_PASSWORD=
