__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# OS
.DS_Store
Thumbs.db

# Secrets (if ever added)
.env

# Auth module SQLite DB — local dev data, never tracked
src/auth/data/

# Career module SQLite DB + LinkedIn screenshot attachments — personal data
src/career/data/

# Credentials module SQLite DB + persisted encryption key — never tracked
src/credentials/data/

